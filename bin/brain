#!/usr/bin/env python3
"""agent-brain command-line entry point (see docs/specification/beta.md, C1)."""

import json
import os
import sys

sys.dont_write_bytecode = True

_SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
_BASE_DIR = os.path.dirname(_SCRIPT_DIR)

KNOWN_SUBCOMMANDS = {
    "setup",
    "validate",
    "persist",
    "recover",
    "rebuild",
    "discover",
    "read",
    "audit",
    "ingest",
    "grant",
}


def _refuse(reason):
    print(json.dumps({"outcome": "refused", "reason": reason}))
    return 2


def _parse_options(argv):
    options = {}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg.startswith("--"):
            key = arg
            if i + 1 < len(argv) and not argv[i + 1].startswith("--"):
                options[key] = argv[i + 1]
                i += 2
            else:
                options[key] = True
                i += 1
        else:
            i += 1
    return options


def _guarded(run):
    """Runs a subcommand's `run()`, which returns (report, exit code).

    C1 (docs/specification/beta.md:163-164): any unexpected error, including
    a failure to load the subcommand's own modules, stays inside the
    single-JSON-object output envelope, exit 1, rather than an escaping
    traceback with empty stdout. `except Exception`, not `BaseException`, so
    SystemExit and KeyboardInterrupt are never captured here. Refusals,
    `vendored_dependency` and every other defined outcome are ordinary return
    values from `run`, never exceptions, so this boundary cannot swallow them.
    """
    try:
        return run()
    except Exception:
        return {"outcome": "error"}, 1


def _run_setup(options):
    from brain_core import setup

    return setup.run_setup(options)


def _run_validate(root):
    from brain_core import vendor_yaml

    try:
        yaml_module = vendor_yaml.load(_BASE_DIR)
    except vendor_yaml.VendoredDependencyError:
        return {"outcome": "error", "reason": "vendored_dependency"}, 1

    duplicate_loader = vendor_yaml.make_duplicate_safe_loader(yaml_module)

    from brain_core import validate

    report = validate.run_validate(root, _BASE_DIR, yaml_module, duplicate_loader)
    return report, 0 if report["outcome"] == "valid" else 3


def _run_persist(root, options):
    from brain_core import vendor_yaml

    try:
        yaml_module = vendor_yaml.load(_BASE_DIR)
    except vendor_yaml.VendoredDependencyError:
        return {"outcome": "error", "reason": "vendored_dependency"}, 1

    duplicate_loader = vendor_yaml.make_duplicate_safe_loader(yaml_module)

    request = _read_request(options)
    if request is None:
        return {"outcome": "refused", "reason": "invalid_request"}, 2

    from brain_core import persist

    return persist.run_persist(request, root, _BASE_DIR, yaml_module, duplicate_loader)


def _run_recover(root, options):
    from brain_core import recover

    return recover.run_recover(root, options)


def main(argv):
    if not argv:
        return _refuse("missing_subcommand")

    subcommand = argv[0]
    if subcommand not in KNOWN_SUBCOMMANDS:
        return _refuse("unknown_subcommand")

    options = _parse_options(argv[1:])

    sys.path.insert(0, _BASE_DIR)

    if subcommand == "setup":
        report, code = _guarded(lambda: _run_setup(options))
    elif subcommand in ("validate", "persist", "recover"):
        root = options.get("--root")
        if not isinstance(root, str):
            return _refuse("missing_root")
        if not os.path.isdir(root):
            return _refuse("invalid_root")
        if subcommand == "validate":
            report, code = _guarded(lambda: _run_validate(root))
        elif subcommand == "recover":
            report, code = _guarded(lambda: _run_recover(root, options))
        else:
            report, code = _guarded(lambda: _run_persist(root, options))
    else:
        return _refuse("not_implemented")
    print(json.dumps(report))
    return code


def _read_request(options):
    """Reads the C1 structured-input JSON: --input <file>, else stdin."""
    input_path = options.get("--input")
    try:
        if isinstance(input_path, str):
            with open(input_path, "r", encoding="utf-8") as fh:
                text = fh.read()
        else:
            text = sys.stdin.read()
        data = json.loads(text)
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
